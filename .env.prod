# Production — gitignored, never loaded by the app; the source of truth for the Vercel env vars
# PORT is intentionally absent: Vercel assigns its own

# Application
NODE_ENV=production
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=https://rms-frontend-roan-psi.vercel.app,http://localhost:5001
REQUEST_TIMEOUT_MS=15000

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

